\newcommand{\termo}[1]{\textbf{#1}\index{#1}}
% toda entrada de \index passa por lmfindice, que cria a chave de ordenação
\newcommand{\lmf@chaveidx}[1]{\directlua{lmfindice("\luaescapestring{\detokenize{#1}}")}}
\def\lmf@idxA#1|#2\@nil{%
  \if\relax\detokenize{#2}\relax\lmf@index{\lmf@chaveidx{#1}}%
  \else\lmf@idxB#1|#2\@nil\fi}
\def\lmf@idxB#1|#2|\@nil{\lmf@index{\lmf@chaveidx{#1}|#2}}
\AtBeginDocument{\let\lmf@index\index
  \renewcommand{\index}[1]{\lmf@idxA#1|\@nil}}
