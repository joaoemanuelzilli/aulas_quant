% ---------------------------------------------------------------- partes
\newcommand{\descricaoparte}{}
% \parte{Título}{Texto curto de abertura}
\newcommand{\parte}[2]{%
  \cleardoublepage
  \refstepcounter{part}%
  \addcontentsline{toc}{part}{Parte \thepart\quad #1}%
  \thispagestyle{vazia}%
  \begin{tikzpicture}[remember picture, overlay]
    \fill[tinta] (current page.south west) rectangle (current page.north east);
    \node[anchor=north east, inner sep=0pt, text=roxo, font=\interdisplay\bfseries\fontsize{300}{300}\selectfont]
      at ([xshift=-14mm, yshift=-22mm]current page.north east) {\thepart};
    \node[anchor=south west, inner sep=0pt, text=white, align=left, text width=135mm]
      at ([xshift=22mm, yshift=40mm]current page.south west)
      {{\sffamily\large\color{lilasmedio}Parte \thepart\par}\vspace{5mm}%
       {\interdisplay\fontsize{38}{42}\selectfont\espacotitulo\raggedright #1\par}\vspace{9mm}%
       {\fontsize{12}{17}\selectfont\espacotitulo\raggedright\color{white}#2\par}};
    \node[anchor=south east, inner sep=0pt] at ([xshift=-20mm, yshift=38mm]current page.south east)
      {\includegraphics[height=13mm]{logoSimples_branco.png}};
  \end{tikzpicture}%
  \null\clearpage
}

% ---------------------------------------------------------------- capítulos
\newlength{\alturafaixa}\setlength{\alturafaixa}{92mm}
\titleformat{\chapter}[block]{}{}{0pt}{\aberturacapitulo}
