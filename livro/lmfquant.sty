\newlength{\largtitulo}
\newcommand{\aberturacapitulo}[1]{%
  \ifnum\value{chapter}>9 \setlength{\largtitulo}{98mm}\else\setlength{\largtitulo}{112mm}\fi
  \begin{tikzpicture}[remember picture, overlay]
    \fill[tinta] (current page.north west) rectangle ([yshift=-\alturafaixa]current page.north east);
    \begin{scope}
      \clip (current page.north west) rectangle ([yshift=-\alturafaixa]current page.north east);
      \node[anchor=south east, inner sep=0pt, text=roxo,
          font=\interdisplay\bfseries\fontsize{\ifnum\value{chapter}>9 165\else 210\fi}{210}\selectfont]
          at ([xshift=-12mm, yshift=-\alturafaixa-\ifnum\value{chapter}>9 7\else 9\fi mm]current page.north east) {\thechapter};
    \end{scope}
    \node[anchor=south west, inner sep=0pt, text=white, align=left, text width=\largtitulo]
      at ([xshift=22mm, yshift=-\alturafaixa+11mm]current page.north west)
      {{\sffamily\normalsize\color{lilasmedio}\@chapapp\ \thechapter\par}\vspace{3mm}%
       {\interdisplay\fontsize{29}{33}\selectfont\espacotitulo\raggedright #1\par}};
  \end{tikzpicture}%
}
\newcommand{\aberturasemnumero}[1]{%
  \begin{tikzpicture}[remember picture, overlay]
    \fill[tinta] (current page.north west) rectangle ([yshift=-52mm]current page.north east);
    \node[anchor=south west, inner sep=0pt, text=white, align=left, text width=140mm]
      at ([xshift=22mm, yshift=-52mm+11mm]current page.north west)
      {\interdisplay\fontsize{29}{33}\selectfont\espacotitulo\raggedright #1\par};
  \end{tikzpicture}%
  \vspace*{-40mm}%
}

