% O TeX Live mínimo não traz os padrões de hifenização do português;
% carregamos o arquivo que acompanha o livro (hyph-pt.pat.txt).
\AtBeginDocument{\directlua{
  local caminho = kpse.find_file("hyph-pt.pat.txt") or "hyph-pt.pat.txt"
  local arq = io.open(caminho, "r")
  if arq then
    local l = lang.new(tex.language)
    lang.clear_patterns(l)
    lang.patterns(l, arq:read("*a"))
    arq:close()
  end
}}
